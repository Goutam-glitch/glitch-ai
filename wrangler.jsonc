{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "glitch-ai",
  "main": "worker/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "8675309",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
